<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:id="@+id/tutorialPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/tutorialTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_title"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/tutorialScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tutorialBubbleOne"
                        android:layout_width="@dimen/bubble_tutorial"
                        android:layout_height="@dimen/bubble_tutorial"
                        android:contentDescription="@string/cd_tutorial_bubble_one"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sprite_bubble_cyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_step_one"
                            android:textColor="@color/bubble_primary_dark"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_body_one"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tutorialBubbleTwo"
                        android:layout_width="@dimen/bubble_tutorial"
                        android:layout_height="@dimen/bubble_tutorial"
                        android:contentDescription="@string/cd_tutorial_bubble_two"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sprite_bubble_pink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_step_two"
                            android:textColor="@color/bubble_primary_dark"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_body_two"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tutorialBubbleThree"
                        android:layout_width="@dimen/bubble_tutorial"
                        android:layout_height="@dimen/bubble_tutorial"
                        android:contentDescription="@string/cd_tutorial_bubble_three"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sprite_current_swirl" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_step_three"
                            android:textColor="@color/bubble_primary_dark"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_body_three"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tutorialGotIt"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_secondary_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/tutorial_got_it" />

    </LinearLayout>

</RelativeLayout>
