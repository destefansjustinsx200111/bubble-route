<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient">

    <ImageView
        android:id="@+id/menuBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.30"
        android:contentDescription="@string/cd_menu_backdrop"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu" />

    <View
        android:id="@+id/menuBlobPink"
        android:layout_width="@dimen/decor_blob"
        android:layout_height="@dimen/decor_blob"
        android:layout_gravity="top|end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-70dp"
        android:background="@drawable/decor_blob_pink" />

    <View
        android:id="@+id/menuBlobYellow"
        android:layout_width="@dimen/decor_blob"
        android:layout_height="@dimen/decor_blob"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-90dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/decor_blob_yellow" />

    <LinearLayout
        android:id="@+id/menuContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_gutter"
        android:paddingTop="@dimen/safe_top"
        android:paddingRight="@dimen/screen_gutter"
        android:paddingBottom="@dimen/safe_bottom">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/menu_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/menuPlayTile"
            style="@style/Widget.App.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bubble_primary"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/menuPlayBubble"
                        android:layout_width="@dimen/bubble_tile"
                        android:layout_height="@dimen/bubble_tile"
                        android:contentDescription="@string/cd_menu_play_bubble"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sprite_bubble_cyan" />

                    <TextView
                        android:id="@+id/menuHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/menu_hint"
                        android:textColor="@color/bubble_text_on_primary"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuPlayButton"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_primary_height"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/menu_play"
                    app:backgroundTint="@color/bubble_primary_dark"
                    app:icon="@drawable/ic_play" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/menuTileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tile_gutter"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menuLevelTile"
                style="@style/Widget.App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.bubbleroute.game.core.ui.LagoonProgressView
                    android:id="@+id/menuLagoonProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md" />

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/tile_gutter"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/menuBestSlot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.bubbleroute.game.core.ui.StatCardView
                    android:id="@+id/menuBestCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:statAccent="@color/bubble_secondary_dark"
                    app:statLabel="@string/menu_best_caption" />

                <ImageView
                    android:id="@+id/menuBestBadge"
                    android:layout_width="@dimen/badge_tile"
                    android:layout_height="@dimen/badge_tile"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/cd_best_badge"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star_badge" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/menuModeCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/menu_mode_caption"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <LinearLayout
            android:id="@+id/menuModeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuModeClassic"
                style="@style/Widget.App.Chip"
                android:layout_width="0dp"
                android:layout_height="@dimen/chip_height"
                android:layout_weight="1"
                android:text="@string/menu_mode_classic" />

            <Space
                android:layout_width="@dimen/tile_gutter"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuModeChallenge"
                style="@style/Widget.App.Chip"
                android:layout_width="0dp"
                android:layout_height="@dimen/chip_height"
                android:layout_weight="1"
                android:text="@string/menu_mode_challenge" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuTutorialButton"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_secondary_height"
            android:layout_marginTop="@dimen/tile_gutter"
            android:text="@string/menu_tutorial"
            app:icon="@drawable/ic_bubble" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
